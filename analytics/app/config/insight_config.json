{
  "period": {
    "defaultGranularity": "MONTH"
  },

  "change": {
    "minimumPercentageChange": 5.0
  },

  "trend": {
    "minimumPeriods": 6,
    "highPersistenceThreshold": 0.8,
    "minimumPersistenceThreshold": 0.75
  },

  "anomaly": {
    "minimumPeriods": 6,
    "method": "IQR",
    "iqrMultiplier": 2.0
  },

  "insightIntegrity": {
    "outlierDependency": {
      "highSlopeReduction": 0.70,
      "mediumSlopeReduction": 0.40,
      "lowSlopeReduction": 0.10
    },
    "oneOffEffect": {
      "highReversionRatio": 0.75,
      "mediumReversionRatio": 0.50,
      "lowReversionRatio": 0.25
    },
    "score": {
      "weights": {
        "consistency": 0.30,
        "contradictionSafety": 0.30,
        "outlierRobustness": 0.15,
        "oneOffRobustness": 0.15,
        "counterEvidence": 0.10
      },
      "riskScores": {
        "NONE": 1.00,
        "LOW": 0.85,
        "MEDIUM": 0.60,
        "HIGH": 0.25
      },
      "consistencyScores": {
        "PASS": 1.00,
        "WARNING": 0.70,
        "FAIL": 0.00
      },
      "contradictionScores": {
        "NONE": 1.00,
        "INSIGHT_CONTRADICTION": 0.40,
        "DATA_CONTRADICTION": 0.00,
        "SEMANTIC_CONTRADICTION": 0.00
      },
      "counterEvidenceScores": {
        "ABSENT": 1.00,
        "PRESENT": 0.85
      }
    }
  },

  "contribution": {
    "minimumAbsoluteContributionShare": 0.20
  },

  "contrast": {
    "minimumPercentagePointGap": 10.0
  },

  "confidence": {
    "weights": {
      "dataQuality": 0.30,
      "sampleSufficiency": 0.20,
      "signalStrength": 0.30,
      "consistency": 0.20
    }
  },

  "businessRelevance": {
    "weights": {
      "metricCriticality": 0.50,
      "directionImpact": 0.30,
      "relationshipContext": 0.20
    },
    "relationshipContext": {
      "typeWeights": {
        "COUNTER_SIGNAL": 0.35,
        "CONTRIBUTES_TO": 0.30,
        "RELATED_ANOMALY": 0.20,
        "CO_MOVES_WITH": 0.15
      }
    },
    "priority": {
      "weights": {
        "importance": 0.40,
        "businessRelevance": 0.40,
        "confidence": 0.20
      },
      "thresholds": {
        "critical": 0.80,
        "high": 0.60,
        "medium": 0.40
      }
    }
  },

  "relationship": {
    "metricCompatibility": {
      "COUNTER_SIGNAL": [
        {
          "sourceMetric": "Orders",
          "targetMetric": "Revenue"
        },
        {
          "sourceMetric": "Customers",
          "targetMetric": "Revenue"
        }
      ],
      "CO_MOVES_WITH": [
        {
          "sourceMetric": "MarketingSpend",
          "targetMetric": "Revenue"
        }
      ]
    }
  },

  "missingContext": {
    "requirementsByMetric": {
      "Revenue": [
        {
          "field": "CompetitorPrice",
          "reason": "Competitor pricing may affect interpretation of Revenue movements."
        },
        {
          "field": "UnitPrice",
          "reason": "AverageOrderValue growth does not establish that individual selling prices increased."
        },
        {
          "field": "PricingChange",
          "reason": "Explicit pricing policy changes are unavailable."
        }
      ]
    }
  }

}
