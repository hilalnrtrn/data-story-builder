{
  "period": {
    "defaultGranularity": "MONTH"
  },

  "change": {
    "minimumPercentageChange": 5.0
  },

  "trend": {
    "minimumPeriods": 6,
    "highPersistenceThreshold": 0.8,
    "minimumPersistenceThreshold": 0.75
  },

  "anomaly": {
    "minimumPeriods": 6,
    "method": "IQR",
    "iqrMultiplier": 2.0
  },

  "contribution": {
    "minimumAbsoluteContributionShare": 0.20
  },

  "contrast": {
    "minimumPercentagePointGap": 10.0
  },

  "confidence": {
    "weights": {
      "dataQuality": 0.30,
      "sampleSufficiency": 0.20,
      "signalStrength": 0.30,
      "consistency": 0.20
    }
  },

  "relationship": {
    "metricCompatibility": {
      "COUNTER_SIGNAL": [
        {
          "sourceMetric": "Orders",
          "targetMetric": "Revenue"
        },
        {
          "sourceMetric": "Customers",
          "targetMetric": "Revenue"
        }
      ],
      "CO_MOVES_WITH": [
        {
          "sourceMetric": "MarketingSpend",
          "targetMetric": "Revenue"
        }
      ]
    }
  }

}
