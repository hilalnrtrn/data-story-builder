{
  "period": {
    "defaultGranularity": "MONTH"
  },

  "change": {
    "minimumPercentageChange": 5.0
  },

  "trend": {
    "minimumPeriods": 6,
    "highPersistenceThreshold": 0.8,
    "minimumPersistenceThreshold": 0.75
  },

  "anomaly": {
    "minimumPeriods": 6,
    "method": "IQR",
    "iqrMultiplier": 2.0
  },

  "contribution": {
    "minimumAbsoluteContributionShare": 0.20
  },

  "contrast": {
    "minimumPercentagePointGap": 10.0
  },

  "confidence": {
    "weights": {
      "dataQuality": 0.30,
      "sampleSufficiency": 0.20,
      "signalStrength": 0.30,
      "consistency": 0.20
    }
  },

  "businessRelevance": {
    "weights": {
      "metricCriticality": 0.50,
      "directionImpact": 0.30,
      "relationshipContext": 0.20
    },
    "relationshipContext": {
      "typeWeights": {
        "COUNTER_SIGNAL": 0.35,
        "CONTRIBUTES_TO": 0.30,
        "RELATED_ANOMALY": 0.20,
        "CO_MOVES_WITH": 0.15
      }
    },
    "priority": {
      "weights": {
        "importance": 0.40,
        "businessRelevance": 0.40,
        "confidence": 0.20
      },
      "thresholds": {
        "critical": 0.80,
        "high": 0.60,
        "medium": 0.40
      }
    }
  },

  "relationship": {
    "metricCompatibility": {
      "COUNTER_SIGNAL": [
        {
          "sourceMetric": "Orders",
          "targetMetric": "Revenue"
        },
        {
          "sourceMetric": "Customers",
          "targetMetric": "Revenue"
        }
      ],
      "CO_MOVES_WITH": [
        {
          "sourceMetric": "MarketingSpend",
          "targetMetric": "Revenue"
        }
      ]
    }
  }

}
