{
  "goldenTruthVersion": "1.0",

  "dataset": {
    "name": "NovaRetail Sales Performance",
    "periodStart": "2025-01-01",
    "periodEnd": "2025-12-31",
    "frequency": "DAILY",
    "grain": [
      "Date",
      "Region",
      "Product",
      "Channel"
    ]
  },

  "datasetExpectations": {
    "expectedColumns": [
      "Date",
      "Region",
      "Category",
      "Product",
      "Channel",
      "Campaign",
      "Revenue",
      "Orders",
      "Customers",
      "Quantity",
      "MarketingSpend",
      "StockLevel",
      "Discount",
      "Returns"
    ],
    "expectedRegionCount": 5,
    "expectedProductCount": 12,
    "expectedCategoryCount": 3,
    "expectedChannelCount": 2
  },

  "requiredInsights": [
    {
      "id": "GT-INS-001",
      "type": "CHANGE",
      "metric": "Revenue",
      "previousPeriod": "2025-05",
      "currentPeriod": "2025-06",
      "expectedDirection": "UP",
      "expectedPreviousValue": 1000000,
      "expectedCurrentValue": 1300000,
      "expectedAbsoluteChange": 300000,
      "expectedPercentageChange": 30.0,
      "tolerance": 0.01
    },
    {
      "id": "GT-INS-002",
      "type": "CHANGE",
      "metric": "Orders",
      "previousPeriod": "2025-05",
      "currentPeriod": "2025-06",
      "expectedDirection": "DOWN",
      "expectedPreviousValue": 10000,
      "expectedCurrentValue": 8500,
      "expectedAbsoluteChange": -1500,
      "expectedPercentageChange": -15.0,
      "tolerance": 0.01
    },
    {
      "id": "GT-INS-003",
      "type": "CHANGE",
      "metric": "Customers",
      "previousPeriod": "2025-05",
      "currentPeriod": "2025-06",
      "expectedDirection": "DOWN",
      "expectedPreviousValue": 8000,
      "expectedCurrentValue": 7040,
      "expectedAbsoluteChange": -960,
      "expectedPercentageChange": -12.0,
      "tolerance": 0.01
    },
    {
      "id": "GT-INS-004",
      "type": "CHANGE",
      "metric": "MarketingSpend",
      "previousPeriod": "2025-05",
      "currentPeriod": "2025-06",
      "expectedDirection": "UP",
      "expectedPreviousValue": 100000,
      "expectedCurrentValue": 120000,
      "expectedAbsoluteChange": 20000,
      "expectedPercentageChange": 20.0,
      "tolerance": 0.01
    }
  ],

  "expectedDerivedMetrics": [
    {
      "id": "GT-DER-001",
      "metric": "AverageOrderValue",
      "formula": "Revenue / Orders",
      "previousPeriod": "2025-05",
      "currentPeriod": "2025-06",
      "expectedPreviousValue": 100.0,
      "expectedCurrentValue": 152.941176,
      "expectedPercentageChange": 52.941176,
      "tolerance": 0.05
    },
    {
      "id": "GT-DER-002",
      "metric": "RevenuePerCustomer",
